# chimera pipeline settings, read by docker compose from ~/chimera/.env on the box.
# deploy/install.sh copies this file to .env on the first install only; after
# that, edit the box's copy and rerun deploy/install.sh.

# The same absolute path on the host and inside chimera-ci.
CHIMERA_HOME=/home/brian/chimera
# brian's ids, so everything the agent writes stays brian's.
CHIMERA_UID=1000
CHIMERA_GID=1000
# The group that owns /var/run/docker.sock (stat -c %g /var/run/docker.sock).
DOCKER_GID=983

PUBLIC_URL=https://chimera.round.rocks
BRANCH=main
POLL_SECONDS=20
# 0 skips bun run test after each deploy.
RUN_TESTS=1
